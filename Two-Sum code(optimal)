class Solution {
public:
    vector<int> twoSum(vector<int>& nums, int target) {
        int n = nums.size();
        unordered_map<int,int>freq;

        for(int i=0;i<n;i++){
            int remaining = target - nums[i];
            if(freq.find(remaining) != freq.end()){
                return {freq[remaining],i};
            }
            freq[nums[i]] = i;
        }
        return {};
    }
};
